# Backend: ollama | openai_compat | openrouter
FORJA_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
# Portátil 16 GB: qwen3:8b · 32 GB Mac / GPU 24 GB: qwen3-coder:30b · alternativa: devstral
FORJA_MODEL=qwen3:8b

# Servidor compartido del aula (vLLM / LiteLLM / LM Studio):
# FORJA_BACKEND=openai_compat
# FORJA_BASE_URL=http://<servidor>:8000/v1
# FORJA_MODEL=Qwen/Qwen3-Coder-30B-A3B-Instruct
# FORJA_API_KEY=x

# OpenRouter (solo open-weight; anthropic/*, openai/* y gpt-oss se bloquean en código):
# FORJA_BACKEND=openrouter
# OPENROUTER_API_KEY=sk-or-...
# FORJA_MODEL=deepseek/deepseek-v3.2
